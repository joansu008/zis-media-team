# Optional local workspace override. Relative paths are resolved from this repo.
ZIS_MEDIA_WORKSPACE=workspace

# Recommended: the Codex Lead delegates through the signed-in Codex session.
# Alternatives: api (provider credential required) or deterministic (explicit offline baseline).
ZIS_EXECUTION_MODE=codex_native

# Provider and per-agent models. Model names are configuration, never business logic.
ZIS_MODEL_PROVIDER=openai
ZIS_CONTENT_MODEL=
ZIS_REVIEW_MODEL=
ZIS_MODEL_MAX_RETRIES=1
ZIS_MODEL_TIMEOUT_SECONDS=60

# OpenAI credential. Keep the real value only in local .env or shell environment.
OPENAI_API_KEY=
# Optional compatible endpoint override; normally leave blank/remove this line.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Path to a local clone of zis-video-workflow. Never commit a machine path.
ZIS_VIDEO_WORKFLOW_PATH=

# Explicit adapter command. It must implement the contract in
# adapters/zis_video_workflow/README.md. Example only:
# ZIS_VIDEO_WORKFLOW_COMMAND=python -m your_package.cli
ZIS_VIDEO_WORKFLOW_COMMAND=
