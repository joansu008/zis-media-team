# Optional local workspace override. Relative paths are resolved from this repo.
ZIS_MEDIA_WORKSPACE=workspace

# Path to a local clone of zis-video-workflow. Never commit a machine path.
ZIS_VIDEO_WORKFLOW_PATH=

# Explicit adapter command. It must implement the contract in
# adapters/zis_video_workflow/README.md. Example only:
# ZIS_VIDEO_WORKFLOW_COMMAND=python -m your_package.cli
ZIS_VIDEO_WORKFLOW_COMMAND=

